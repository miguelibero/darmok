{
    "files": {
        "sponza/Sponza.gltf": {
            "scene": {
                "outputPath": "../Sponza.dsc",
                "program": "Forward",
                "embedTextures": true,
                "shadowType": "Soft",
                "textureFlags": ["BGFX_TEXTURE_MSAA_SAMPLE", "MIN_ANISOTROPIC", "MAG_ANISOTROPIC"],
                "programDefines": ["SHADOW_ENABLED"],
                "generateTextureMips": true
            }
        },
        "environment.exr": {
            "texture": {
                "outputPath": "skybox.bin",
                "convertCubemap": true
            },
            "env_texture": {
                "irradiance": {
                    "outputPath": "env_irradiance.bin",
                    "size": 32,
                    "samples": 256
                },
                "prefiltered" : {
                    "outputPath": "env_prefiltered.bin",
                    "size": 128,
                    "samples": 1024
                }
            }
        }
    }
}